# Token API Proxmox VE (lecture seule recommandé)
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=

# Token facultatif pour l'agent HTTP Linux (/metrics)
LINUX_METRICS_TOKEN=

# Mot de passe HTTP Basic des API /api/*. Obligatoire si exposé sur Internet.
DASHBOARD_PASSWORD=

# 0 = autonome. 1 si nginx termine le HTTPS devant le conteneur
# (nécessaire pour le rate limiter et HSTS).
TRUST_PROXY=0

# 1 uniquement si vos hôtes surveillés utilisent des certificats auto-signés
DASHBOARD_INSECURE_TLS=

# Allowlist des variables référençables (tokenEnv/tokenIdEnv/tokenSecretEnv),
# séparées par des virgules. Par défaut : PROXMOX_TOKEN_ID, PROXMOX_TOKEN_SECRET, LINUX_METRICS_TOKEN.
DASHBOARD_TOKEN_ENVS=