# Dashmon login password. Mandatory with Docker Compose; a browser stays
# signed in for 30 days on that device.
DASHMON_PASSWORD=

# 0 = standalone. 1 if nginx terminates HTTPS in front of the container
# (needed by the rate limiter and HSTS). Guide: docs/HTTPS.md
TRUST_PROXY=0

# 1 only if your monitored hosts use self-signed certificates
DASHBOARD_INSECURE_TLS=

# Path of a PEM bundle of private certificate authorities, mounted in the
# container (see section 8 of deploy/DEPLOYMENT.md). Added to Node's roots:
# better than DASHBOARD_INSECURE_TLS, which turns every check off.
NODE_EXTRA_CA_CERTS=

# DNS resolver for the local names (.lan…) used by the status dots and the
# widgets (Uptime Kuma included). IP address of the resolver (e.g. AdGuard,
# Pi-hole), never a name. Empty = Docker's internal resolver. See section 7 of
# deploy/DEPLOYMENT.md.
DASHMON_DNS=

# Master key encrypting the widget secrets (e.g. Duplicati password) in
# config.json (AES-256-GCM). MANDATORY for the main dashboard (not needed by an
# agent). Keep it somewhere safe: without it, widget passwords must be entered
# again.
# Generate: openssl rand -hex 32  (or PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)))
DASHMON_MASTER_KEY=

# Secret shared with the supervision agents (generate a random value).
DASHMON_SYNC_TOKEN=

# --- Host supervision (passed on by docker-compose.yml) ---------------------

# Refresh interval of the host measurements, in seconds (minimum 5, maximum
# 3600, 60 by default). Raise it to spare a small host (Raspberry Pi), lower it
# for more responsive figures. Also applies to reading the local WireGuard dump.
HOST_METRICS_INTERVAL=60

# The reports below are written by the deploy/*.sh scripts (host cron). Empty =
# the default file in DATA_DIR. Each guide explains the installation.

# Output of `wg show all dump` for the local host. Default:
# DATA_DIR/wireguard.dump. Script: deploy/wireguard-dump.sh, guide:
# docs/WIREGUARD.md.
WIREGUARD_DUMP_FILE=

# SMART report of the local host. Default: DATA_DIR/smart.json. Script:
# deploy/smart-dump.sh, guide: docs/SMART.md.
SMART_DUMP_FILE=

# APT updates report of the local host. Default: DATA_DIR/apt-updates.json.
# Script: deploy/apt-updates.sh, guide: docs/APT_UPDATES.md.
APT_UPDATES_REPORT_FILE=

# OpenCode usage statistics. Default: DATA_DIR/opencode.json. Script:
# deploy/opencode-stats.sh, guide: docs/OPENCODE.md.
OPENCODE_REPORT_FILE=

# Claude Code usage statistics. Default: DATA_DIR/claude.json. Script:
# deploy/claude-stats.sh, guide: docs/CLAUDE_CODE.md.
CLAUDE_REPORT_FILE=
