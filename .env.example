# Token API Proxmox VE (lecture seule recommandé)
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=

# Token facultatif pour l'agent HTTP Linux (/metrics)
LINUX_METRICS_TOKEN=

# Sécurité du dashboard
# ---------------------
# Mot de passe recommandé : protège les API /api/* en HTTP Basic Auth.
# À définir OBLIGATOIREMENT si le dashboard est exposé sur Internet
# (même derrière nginx HTTPS). Laissez vide uniquement en réseau local de confiance.
DASHBOARD_PASSWORD=

# Nombre de reverse proxies de confiance devant le conteneur (facultatif).
# 0 (défaut) = image autonome, accessible en direct. Mettez 1 uniquement
# si nginx (ou un autre proxy) terminee le HTTPS devant le conteneur.
# Permet au rate limiter et à l'en-tête HSTS d'utiliser l'adresse réelle du client.
TRUST_PROXY=0

# TLS strict : par défaut le dashboard refuse les certificats invalides
# lors des vérifications de statut et des métriques.
# Mettre à 1 uniquement si vos hôtes utilisent des certificats auto-signés.
DASHBOARD_INSECURE_TLS=

# Allowlist des variables d'environnement référençables dans la config
# (champs tokenEnv / tokenIdEnv / tokenSecretEnv des hôtes).
# Par défaut : PROXMOX_TOKEN_ID, PROXMOX_TOKEN_SECRET, LINUX_METRICS_TOKEN.
# Ajoutez vos propres noms, séparés par des virgules.
DASHBOARD_TOKEN_ENVS=