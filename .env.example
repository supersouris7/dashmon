# Mot de passe HTTP Basic des API /api/*. Obligatoire si exposé sur Internet.
DASHBOARD_PASSWORD=

# 0 = autonome. 1 si nginx termine le HTTPS devant le conteneur
# (nécessaire pour le rate limiter et HSTS).
TRUST_PROXY=0

# 1 uniquement si vos hôtes surveillés utilisent des certificats auto-signés
DASHBOARD_INSECURE_TLS=

# Chemin d'un bundle PEM d'autorités de certification privées, monté dans le
# conteneur (voir deploy/DEPLOYMENT.md §7). S'ajoute aux racines de Node :
# préférable à DASHBOARD_INSECURE_TLS, qui désactive toute vérification.
NODE_EXTRA_CA_CERTS=

# Résolveur DNS pour les noms locaux (.lan…) utilisés par les pastilles d'état
# et les widgets (Uptime Kuma compris). Adresse IP du résolveur (ex. AdGuard,
# Pi-hole), jamais un nom. Vide = résolveur interne de Docker. Voir
# deploy/DEPLOYMENT.md §6.
DASHMON_DNS=

# Clé maîtresse de chiffrement des secrets des widgets (ex. mot de passe Duplicati)
# dans config.json (AES-256-GCM). Si vide, les secrets restent en clair.
# Génération : openssl rand -base64 32  (ou PowerShell :
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)))
DASHMON_MASTER_KEY=

# --- Supervision des hôtes ---------------------------------------------------
# Jeton API Proxmox (identifiant de token, ex. dashmon@pve!metrics). Déclaré
# nommément dans la config d'un hôte de type Proxmox ; voir deploy/DEPLOYMENT.md.
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=

# Jeton Bearer attendu par un agent Linux maison (endpoint JSON) quand l'hôte
# supervisé de type "linux" le réclame.
LINUX_METRICS_TOKEN=

# Liste d'allowlist séparée par des virgules, pour exposer des variables
# d'environnement supplémentaires comme sources de jeton. Les noms ci-dessus
# sont déjà autorisés ; n'ajoutez ici que des variables que vous contrôlez.
# Un nom absent de cette liste est refusé par le serveur.
DASHBOARD_TOKEN_ENVS=

# Fichier contenant la sortie de `wg show all dump` pour les hôtes de type
# "local" (supervision WireGuard). Vide = DATA_DIR/wireguard.dump. Un cron ou un
# timer sur l'hôte doit réécrire ce fichier ; voir deploy/DEPLOYMENT.md §8.
WIREGUARD_DUMP_FILE=
