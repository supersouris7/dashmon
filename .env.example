# Mot de passe de connexion Dashmon. Obligatoire avec Docker Compose ; la
# connexion par navigateur reste active 30 jours sur cet appareil.
DASHMON_PASSWORD=

# 0 = autonome. 1 si nginx termine le HTTPS devant le conteneur
# (nécessaire pour le rate limiter et HSTS). Guide : docs/HTTPS.md
TRUST_PROXY=0

# 1 uniquement si vos hôtes surveillés utilisent des certificats auto-signés
DASHBOARD_INSECURE_TLS=

# Chemin d'un bundle PEM d'autorités de certification privées, monté dans le
# conteneur (voir deploy/DEPLOYMENT.md §7). S'ajoute aux racines de Node :
# préférable à DASHBOARD_INSECURE_TLS, qui désactive toute vérification.
NODE_EXTRA_CA_CERTS=

# Résolveur DNS pour les noms locaux (.lan…) utilisés par les pastilles d'état
# et les widgets (Uptime Kuma compris). Adresse IP du résolveur (ex. AdGuard,
# Pi-hole), jamais un nom. Vide = résolveur interne de Docker. Voir
# deploy/DEPLOYMENT.md §6.
DASHMON_DNS=

# Clé maîtresse de chiffrement des secrets des widgets (ex. mot de passe Duplicati)
# dans config.json (AES-256-GCM). Si vide, les secrets restent en clair.
# Génération : openssl rand -base64 32  (ou PowerShell :
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)))
DASHMON_MASTER_KEY=

# Secret partage avec les agents de supervision (generer une valeur aleatoire).
DASHMON_SYNC_TOKEN=

# --- Supervision des hôtes (transmise par docker-compose.yml) ---------------

# Intervalle de rafraîchissement des mesures d'hôtes, en secondes (minimum 5,
# maximum 3600 ; 60 par défaut). Augmentez-le pour ménager un petit hôte
# (Raspberry Pi), diminuez-le pour des chiffres plus réactifs. Vaut aussi pour
# la lecture du dump WireGuard local.
HOST_METRICS_INTERVAL=60


# Fichier contenant la sortie de `wg show all dump` pour les hôtes de type
# "local" (supervision WireGuard) et la tuile wireguard. Vide =
# DATA_DIR/wireguard.dump. Le script deploy/wireguard-dump.sh (cron sur l'hôte)
# réécrit ce fichier ; voir docs/WIREGUARD.md.
WIREGUARD_DUMP_FILE=

# Fichier JSON SMART des hôtes de type "local". Vide = DATA_DIR/smart.json.
# Le script deploy/smart-dump.sh le met a jour ; voir docs/SMART.md.
SMART_DUMP_FILE=

# Rapport JSON des mises a jour APT locales. Vide = DATA_DIR/apt-updates.json.
# deploy/apt-updates.sh le met a jour depuis le cron de l'hote ; voir docs/APT_UPDATES.md.
APT_UPDATES_REPORT_FILE=
