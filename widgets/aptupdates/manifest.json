      "name": "Mises a jour APT",
      "updated": "a jour",
      "updatedOne": "mise a jour installee",
      "updatedMany": "mises a jour installees",
      "failed": "echec de la mise a jour",
      "rebootRequired": "redemarrage requis",
      "rebooting": "redemarrage lance",
      "noReport": "rapport APT introuvable",
      "lastRun": "dernier passage",
      "error": "APT"
    },
    "en": {
      "name": "APT updates",
      "updated": "up to date",
      "updatedOne": "update installed",
      "updatedMany": "updates installed",
      "failed": "update failed",
      "rebootRequired": "reboot required",
      "rebooting": "reboot started",
      "noReport": "APT report not found",
      "lastRun": "last run",
      "error": "APT"
    }
  },
  "config": []
}
