{
  "id": "opencode",
  "version": "1.0.1",
  "label": {
    "fr": "OpenCode",
    "en": "OpenCode"
  },
  "description": {
    "fr": "Tokens du jour et des 30 derniers jours, lus dans le rapport de supervision",
    "en": "Tokens of the day and of the last 30 days, read from the supervision report"
