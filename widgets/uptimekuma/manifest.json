{
  "id": "uptimekuma",
  "version": "1.0.0",
  "label": { "fr": "Uptime Kuma", "en": "Uptime Kuma" },
  "description": {
    "fr": "Compte les moniteurs en ligne et hors ligne d'une page de statut Uptime Kuma",
    "en": "Counts the up and down monitors of an Uptime Kuma status page"
  },
  "interval": 60000,
  "cacheKey": "config",
  "server": "server.js",
  "client": "client.mjs",
  "strings": {
    "fr": {
      "name": "Uptime Kuma",
      "url": "Adresse de l'instance",
      "urlPlaceholder": "https://kuma.exemple.lan",
      "slug": "Identifiant de la page de statut",
      "slugPlaceholder": "kuma",
      "password": "Mot de passe de la page (si privée)",
      "passwordConfigured": "Mot de passe enregistré (laisser vide pour ne pas le changer)",
      "up": "en ligne",
      "down": "hors ligne",
      "monitor": "moniteur",
      "monitors": "moniteurs",
      "missingConfig": "Adresse ou page de statut manquante",
      "badAnswer": "Réponse illisible d'Uptime Kuma",
      "error": "Uptime Kuma"
    },
    "en": {
      "name": "Uptime Kuma",
      "url": "Instance address",
      "urlPlaceholder": "https://kuma.example.lan",
      "slug": "Status page slug",
      "slugPlaceholder": "kuma",
      "password": "Status page password (if private)",
      "passwordConfigured": "Password saved (leave empty to keep it)",
      "up": "up",
      "down": "down",
      "monitor": "monitor",
      "monitors": "monitors",
      "missingConfig": "Missing address or status page",
      "badAnswer": "Unreadable answer from Uptime Kuma",
      "error": "Uptime Kuma"
    }
  },
  "config": [
    {
      "key": "url",
      "type": "text",
      "label": "url",
      "maxLength": 200,
      "placeholder": "urlPlaceholder"
    },
    {
      "key": "slug",
      "type": "text",
      "label": "slug",
      "maxLength": 100,
      "placeholder": "slugPlaceholder"
    },
    {
      "key": "password",
      "type": "secret",
      "label": "password",
      "maxLength": 200
    }
  ]
}