{
  "id": "uptimekuma",
  "version": "2.0.0",
  "label": { "fr": "Uptime Kuma", "en": "Uptime Kuma" },
  "description": {
    "fr": "Une ligne par page de statut : vert si tout est en ligne, rouge sinon",
    "en": "One line per status page: green if everything is up, red otherwise"
  },
  "interval": 60000,
  "cacheKey": "config",
  "server": "server.js",
  "client": "client.mjs",
  "strings": {
    "fr": {
      "name": "Uptime Kuma",
      "url": "Adresse de l'instance",
      "urlPlaceholder": "https://kuma.exemple.lan",
      "slug1": "Première page de statut",
      "slug1Placeholder": "services",
      "slug2": "Seconde page de statut (facultatif)",
      "slug2Placeholder": "infrastructure",
      "missingConfig": "Adresse ou page de statut manquante",
      "noMonitors": "Aucun moniteur public sur cette page",
      "badSlug": "Page de statut introuvable",
      "unreachable": "Instance injoignable"
    },
    "en": {
      "name": "Uptime Kuma",
      "url": "Instance address",
      "urlPlaceholder": "https://kuma.example.lan",
      "slug1": "First status page",
      "slug1Placeholder": "services",
      "slug2": "Second status page (optional)",
      "slug2Placeholder": "infrastructure",
      "missingConfig": "Missing address or status page",
      "noMonitors": "No public monitor on this page",
      "badSlug": "Status page not found",
      "unreachable": "Instance unreachable"
    }
  },
  "config": [
    {
      "key": "url",
      "type": "text",
      "label": "url",
      "maxLength": 200,
      "placeholder": "urlPlaceholder"
    },
    {
      "key": "slug1",
      "type": "text",
      "label": "slug1",
      "maxLength": 100,
      "placeholder": "slug1Placeholder"
    },
    {
      "key": "slug2",
      "type": "text",
      "label": "slug2",
      "maxLength": 100,
      "placeholder": "slug2Placeholder"
    }
  ]
}