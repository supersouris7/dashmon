{
  "id": "ping",
  "version": "1.0.0",
  "label": { "fr": "Ping", "en": "Ping" },
  "description": {
    "fr": "Teste si un hôte répond : résolution du nom puis connexion TCP",
    "en": "Tests whether a host answers: name resolution then TCP connection"
  },
  "interval": 60000,
  "cacheKey": "config",
  "probe": true,
  "server": "server.js",
  "client": "client.mjs",
  "strings": {
    "fr": {
      "name": "Ping",
      "host": "Hôte testé",
      "hostPlaceholder": "192.0.2.10 ou nas.exemple.lan",
      "port": "Port TCP",
      "reachable": "Répond",
      "unreachable": "Ne répond pas",
      "missingHost": "Adresse manquante",
      "unresolved": "Nom introuvable",
      "noAnswer": "Port fermé ou injoignable",
      "error": "Ping"
    },
    "en": {
      "name": "Ping",
      "host": "Tested host",
      "hostPlaceholder": "192.0.2.10 or nas.example.lan",
      "port": "TCP port",
      "reachable": "Answers",
      "unreachable": "Does not answer",
      "missingHost": "Missing address",
      "unresolved": "Host not found",
      "noAnswer": "Port closed or unreachable",
      "error": "Ping"
    }
  },
  "config": [
    {
      "key": "host",
      "type": "text",
      "label": "host",
      "maxLength": 200,
      "placeholder": "hostPlaceholder"
    },
    {
      "key": "port",
      "type": "number",
      "label": "port",
      "default": 0,
      "min": 0,
      "max": 65535
    }
  ]
}