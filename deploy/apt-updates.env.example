# Fichier /etc/default/dashmon-apt-updates lu par cron.
# 0 = signale le redemarrage requis sans redemarrer ; 1 = redemarre l'hote.
DASHMON_APT_REBOOT=0

# Nom du conteneur Dashmon, si different de dashmon.
# DASHMON_CONTAINER=dashmon

# Par defaut, le rapport est ecrit dans /app/data/apt-updates.json du
# conteneur, a cote des dumps WireGuard et SMART. Variante bind mount : chemin
# du rapport sur l'hote.
# DASHMON_APT_REPORT_FILE=/opt/dashmon/apt-updates.json
